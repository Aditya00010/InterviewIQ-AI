# Backend Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
# - For Local MongoDB: Use "mongodb://host.docker.internal:27017/interviewiq"
# - For MongoDB Atlas: Use your Atlas connection string "mongodb+srv://..."
MONGO_URI=mongodb://host.docker.internal:27017/interviewiq

# Security Configuration
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Configuration
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Frontend URL (Used for CORS validation)
FRONTEND_URL=http://localhost
